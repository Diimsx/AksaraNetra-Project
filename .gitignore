# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files
.env.local
.env.*.local

# audit results
/audit_results/
*scan-result*
*.report.html
playwright-report/
test-results/

# engine terukur
/engine/node_modules
/engine/output*/
/engine/ui/data/

# Catatan: /public/data TIDAK diabaikan.
# Isinya adalah hasil audit yang harus ikut ter-deploy, karena halaman
# /katalog membacanya sebagai berkas statis. Kalau folder ini diabaikan,
# situs yang sudah live akan menampilkan pesan "hasil audit belum tersedia".

# backend runtime data
/backend/data/

# keep safe configuration template
!**/.env.example
"backend/backend/" 
