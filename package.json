{
  "name": "project-a",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "engine:install": "cd engine && npm install && npx playwright install chromium",
    "engine:test": "cd engine && npm test",
    "build:data": "cd engine && DATA_DIR=../public/data node scripts/build-data.mjs",
    "test:reader": "cd engine && READER_FILE=../public/data/sulselprov/reader.html node scripts/test-reader.mjs",
